{
  "manifestVersion": 5,
  "id": "com.kimsj.premiere.mcpbridge",
  "name": "MCP Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mcpBridgePanel",
      "label": { "default": "MCP Bridge" },
      "minimumSize": { "width": 230, "height": 200 },
      "preferredDockedSize": { "width": 300, "height": 300 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  }
}
