{
  "id": "com.sje.pr.edit.pro",
  "name": "SJE PR Edit Pro",
  "version": "2.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sje-pr-edit-pro-panel",
      "label": { "default": "SJE PR Edit Pro" },
      "minimumSize": { "width": 300, "height": 700 },
      "preferredDockedSize": { "width": 300, "height": 700 },
      "maximumSize": { "width": 600, "height": 1200 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [ "https://script.google.com" ]
    }
  }
}
